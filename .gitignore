# Publish source, canonical experiment entries, and reproducible project setup.
/*
!/.gitignore
!/.github/
!/.pre-commit-config.yaml
!/.python-version
!/Makefile
!/README.md
!/pyproject.toml
!/uv.lock
!/configs/
!/scripts/
!/src/
!/tests/
!/tools/
!/aim[1-4]_*.py

# Generated files, local environments, credentials, and research data.
__pycache__/
*.py[cod]
*.ipynb_checkpoints
.venv/
.env
.env.*
!.env.example
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.uv-tools/
*.egg-info/
wandb/
.DS_Store
.coverage
coverage.xml
htmlcov/
*.pkl
*.pth
*.ckpt
*.h5
*.parquet
*.npy
*.npz
*.bin
*.onnx
*.pt
*.log
*.csv
*.sqlite
*.tar
*.gz
*.zip
!tests/fixtures/**
